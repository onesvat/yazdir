#: src/yazdir/app.py:445
#, python-brace-format
msgid "<b>1.</b> Take <b>all {n} sheets</b> from the output tray without changing their order."
msgstr "<b>1.</b> Çıktı tepsisindeki <b>{n} kâğıdın tamamını</b> sırasını bozmadan alın."

#: src/yazdir/app.py:446
msgid "<b>2.</b> Put them in the front input tray <b>without flipping or rotating</b>: edge <b>B</b> towards the printer, blank sides up."
msgstr "<b>2.</b> <b>Ters çevirmeden, döndürmeden</b> öndeki besleme tepsisine koyun: <b>B</b> kenarı yazıcıya doğru, boş yüzler üstte."

#: src/yazdir/app.py:448
msgid "<b>3.</b> Press <b>Continue</b>."
msgstr "<b>3.</b> <b>Devam</b>'a basın."

#: src/yazdir/app.py:451
msgid "The top sheet has an empty back and will pass through blank. Don't remove it; it keeps the other sheets in order."
msgstr "En üstteki kâğıdın arkası boş kalacak ve yazıcıdan boş geçecek. Çıkarmayın; diğer kâğıtların sırası bozulmasın diye gerekli."

#: src/yazdir/app.py:456
msgid "Manual duplex"
msgstr "Elle arkalı önlü"

#: src/yazdir/app.py:461
#, python-brace-format
